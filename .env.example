# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
STOCK_MONITOR_DB_PATH=data/stock_monitor.db
STOCK_MONITOR_BASE_URL=https://stock.naver.com/research/company
STOCK_MONITOR_TIMEZONE=Asia/Seoul
STOCK_MONITOR_HEADLESS=true

# -----------------------------------------------------------------------------
# Naver report fetch/parser
# -----------------------------------------------------------------------------
STOCK_MONITOR_BROWSER_TIMEOUT_MS=30000
STOCK_MONITOR_API_PAGE_SIZE=50
STOCK_MONITOR_API_MAX_PAGES=20

# -----------------------------------------------------------------------------
# Scheduler and Korean business-day guards
# -----------------------------------------------------------------------------
STOCK_MONITOR_TASK_PREFIX=StockMonitor
STOCK_MONITOR_POLL_START_TIME=08:30
STOCK_MONITOR_POLL_END_TIME=16:30
STOCK_MONITOR_HOLIDAYS=2026-01-01,2026-02-16,2026-02-17,2026-02-18,2026-03-02,2026-05-01,2026-05-05,2026-05-25,2026-08-17,2026-09-24,2026-09-25,2026-10-05,2026-10-09,2026-12-25,2026-12-31
STOCK_MONITOR_RUN_SUPPRESSED_DATES=

# -----------------------------------------------------------------------------
# Telegram notification and command worker
# Required on the mini PC before production notification/command operation.
# -----------------------------------------------------------------------------
STOCK_MONITOR_TELEGRAM_BOT_TOKEN=
STOCK_MONITOR_TELEGRAM_CHAT_ID=
STOCK_MONITOR_TELEGRAM_TIMEOUT_SECONDS=30
STOCK_MONITOR_TELEGRAM_MAX_RETRIES=3
STOCK_MONITOR_TELEGRAM_RETRY_DELAY_SECONDS=2

# -----------------------------------------------------------------------------
# Daily summary / briefing display policy
# -----------------------------------------------------------------------------
STOCK_MONITOR_NOTIFICATION_DEFAULT_LIMIT=7
STOCK_MONITOR_DAILY_SUMMARY_MIN_MENTION_COUNT=2
STOCK_MONITOR_DAILY_SUMMARY_REQUIRE_TARGET_PRICE=true

# -----------------------------------------------------------------------------
# Admin-gui / web-view access gate and rotation overlay
# access-code hash file is intentionally excluded from migration archives.
# Create it on the target PC with: python -m stock_monitor access-code set
# -----------------------------------------------------------------------------
STOCK_MONITOR_ACCESS_CODE_PATH=data/access_code.json
STOCK_MONITOR_ROTATION_OVERLAY_COORDINATES_PATH=data/rotation_overlay_coordinates.json

# -----------------------------------------------------------------------------
# KRX Open API
# Required for 08:10 daily stock/ETF/index snapshot backfill.
# Keep the real key only in local .env.
# -----------------------------------------------------------------------------
STOCK_MONITOR_KRX_AUTH_KEY=
STOCK_MONITOR_KRX_BASE_URL=https://data-dbg.krx.co.kr
STOCK_MONITOR_KRX_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# KRX Data Marketplace
# Required only for logged-in [12009] same-day mentioned-stock investor-flow
# backfill or validation. Broad scheduled ingest remains forbidden.
# Legacy fallback names KRX_ID/KRX_PW are supported by code, but the
# STOCK_MONITOR_* names below are the canonical local .env keys.
# -----------------------------------------------------------------------------
STOCK_MONITOR_KRX_DATA_MARKET_BASE_URL=https://data.krx.co.kr
STOCK_MONITOR_KRX_DATA_MARKET_ID=
STOCK_MONITOR_KRX_DATA_MARKET_PASSWORD=
